// ==========================================================
// SCHEMA DO BANCO - Plataforma de Estudos ENEM/Vestibular
// ==========================================================
// Organizado por domínio: Usuário -> Matérias -> Questões -> Progresso
// Pensado para crescer: novos modelos podem ser adicionados sem
// quebrar os existentes (relações usam IDs, nunca campos soltos).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- USUÁRIO ----------------

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  targetExam          ExamType  @default(ENEM)
  aiExplanationsUsed   Int       @default(0)
  customSearchesUsed   Int       @default(0)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastStudyDate       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  weakSubjects  UserSubject[]
  studyPlans    StudyPlan[]
  attempts      Attempt[]
  progress      Progress[]
  savedCustomTopics UserCustomTopic[]
}

enum ExamType {
  ENEM
  FUVEST
  UNICAMP
  OUTRO
}

// ---------------- MATÉRIAS ----------------

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique   // ex: "Matemática", "Química"
  area        String?            // ex: "Ciências da Natureza"

  topics        Topic[]
  users         UserSubject[]
  questions     Question[]
  progress      Progress[]
  studySessions StudySession[]
}

model Topic {
  id          String   @id @default(uuid())
  name        String             // ex: "Funções", "Estequiometria"
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])

  questions   Question[]
}

// Relação N:N entre User e Subject, guardando o nível de dificuldade
// que o próprio aluno declarou (base pro cronograma)
model UserSubject {
  id          String   @id @default(uuid())
  userId      String
  subjectId   String
  difficulty  Int      @default(3) // 1 (fácil) a 5 (muito difícil)

  user        User     @relation(fields: [userId], references: [id])
  subject     Subject  @relation(fields: [subjectId], references: [id])

  @@unique([userId, subjectId])
}

// ---------------- QUESTÕES ----------------

model Question {
  id            String    @id @default(uuid())
  statement     String    // enunciado
  imageUrl      String?   // imagem/gráfico/mapa que acompanha o texto-base, se houver
  year          Int?      // ano da prova (ex: 2023)
  source        String?   // ex: "ENEM 2023 - Dia 1"
  subjectId     String
  topicId       String?
  difficulty    Int       @default(3)
  explanation   String?   // explicação fixa, escrita à mão — não gasta IA

  subject       Subject   @relation(fields: [subjectId], references: [id])
  topic         Topic?    @relation(fields: [topicId], references: [id])
  alternatives  Alternative[]
  attempts      Attempt[]
}

model Alternative {
  id          String   @id @default(uuid())
  questionId  String
  label       String   // "A", "B", "C"...
  text        String
  isCorrect   Boolean  @default(false)

  question    Question @relation(fields: [questionId], references: [id])
}

// ---------------- SIMULADOS / TENTATIVAS ----------------

model Attempt {
  id                String   @id @default(uuid())
  userId            String
  questionId        String
  chosenLabel       String?  // qual alternativa o aluno marcou
  isCorrect         Boolean
  aiExplanation     String?  // explicação gerada por IA quando erra
  timeSpentSeconds  Int?     // quanto tempo o aluno levou nessa questão
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id])
  question          Question @relation(fields: [questionId], references: [id])
}

// ---------------- CRONOGRAMA (SPACED REPETITION) ----------------

model StudyPlan {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime
  createdAt   DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  sessions    StudySession[]
}

model StudySession {
  id            String    @id @default(uuid())
  studyPlanId   String
  subjectId     String
  scheduledFor  DateTime
  durationMin   Int       @default(45)
  completed     Boolean   @default(false)

  studyPlan     StudyPlan @relation(fields: [studyPlanId], references: [id])
  subject       Subject   @relation(fields: [subjectId], references: [id])
}

// ---------------- PROGRESSO ----------------

model Progress {
  id            String   @id @default(uuid())
  userId        String
  subjectId     String
  correctCount  Int      @default(0)
  totalCount    Int      @default(0)
  lastReviewed  DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])

  @@unique([userId, subjectId])
}

// ---------------- PESQUISA LIVRE (qualquer assunto, não só ENEM) ----------------
// Modelo separado do catálogo fixo do ENEM: aqui o conteúdo é gerado sob
// demanda por IA na primeira pesquisa, e depois fica em cache pra todo mundo.

model CustomTopic {
  id        String   @id @default(uuid())
  query     String   // texto original digitado pelo usuário, ex: "Cálculo I"
  slug      String   @unique // normalizado, usado como chave de cache: "calculo-i"
  summary   String   // resumo/explicação do assunto, gerado por IA
  createdAt DateTime @default(now())

  questions    CustomQuestion[]
  savedByUsers UserCustomTopic[]
}

// Um usuário "salvando" um assunto que pesquisou, pra ele aparecer em
// /materias e poder ser incluído no simulado personalizado.
model UserCustomTopic {
  id            String   @id @default(uuid())
  userId        String
  customTopicId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  customTopic CustomTopic @relation(fields: [customTopicId], references: [id])

  @@unique([userId, customTopicId])
}

model CustomQuestion {
  id            String   @id @default(uuid())
  customTopicId String
  statement     String
  explanation   String

  customTopic   CustomTopic @relation(fields: [customTopicId], references: [id])
  alternatives  CustomAlternative[]
}

model CustomAlternative {
  id               String  @id @default(uuid())
  customQuestionId String
  label            String
  text             String
  isCorrect        Boolean @default(false)

  customQuestion   CustomQuestion @relation(fields: [customQuestionId], references: [id])
}
