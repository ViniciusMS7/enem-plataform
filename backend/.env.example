DATABASE_URL="postgresql://user:senha@localhost:5432/enem_platform"
JWT_SECRET="troque_isso_por_algo_seguro"

# Gemini API (Google AI Studio) — grátis, sem cartão de crédito.
# Pegue sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY="sua_chave_da_api_aqui"
# Opcional: troque o modelo (padrão: gemini-flash-lite-latest, que sempre
# aponta pro Flash-Lite mais recente e evita quebrar quando o Google
# descontinuar uma versão específica).
GEMINI_MODEL="gemini-flash-lite-latest"

# URL do seu frontend em produção (deixe vazio/comentado em dev local).
# Restringe quem pode chamar essa API.
# FRONTEND_URL="https://seu-app.vercel.app"

PORT=3333
